# --- App ---
APP_ENV=development
APP_NAME=Land Record Digitization API
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (fill in with real project values) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Table names (override if your DB schema uses different names)
SUPABASE_DOCUMENTS_TABLE=documents
SUPABASE_RECORDS_TABLE=land_records

# --- Storage ---
SUPABASE_STORAGE_BUCKET=land-record-documents

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.tiff
