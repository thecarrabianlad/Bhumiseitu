# Copy this file to ".env" and fill in real values when you have an
# LLM API key. Never commit your real .env file to git.

# Which provider to call: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Your secret API key. Leave blank / omit this file entirely to use
# the MockLLMClient automatically (no key needed for development).
LLM_API_KEY=

# Model name for the chosen provider, e.g.:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o-mini
LLM_MODEL=claude-sonnet-4-6
